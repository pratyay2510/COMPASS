# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Python virtual environments and packaging output
.venv/
*/.venv/
venv/
env/
ENV/
__pypackages__/
*.egg-info/
.eggs/
build/
dist/
wheels/

# Jupyter/IPython local state
.ipynb_checkpoints/
profile_default/
ipython_config.py

# HuggingFace, dataset, and model caches live outside the repo (data/paths.py).
# ROOT-ANCHORED on purpose: unanchored, `datasets/` and `models/` match at any
# depth and would silently drop real source directories inside the vendored
# reference repos under baselines/vendor/.
/hf_cache/
.cache/
/cache-dirs/
/datasets/
/hub/
/models/
/embeddings/

# Model weights, checkpoints, and serialized run artifacts
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.onnx
*.npz
checkpoints/
model_weight/

# Experiment outputs and logs. Root-anchored for the same reason as the cache
# block above: `output/`, `result/`, `runs/` and `logs/` are ordinary words that
# appear as source directories in vendored repos. Per-project output paths are
# listed explicitly under "COMPASS: run artifacts".
/outputs/
/output/
/results/
/result/
/runs/
wandb/
lightning_logs/
/logs/
*.log
slurm-*.out
slurm-*.err

# Scratch files
/tmp/
/temp/
/temp*/

# Machine-local git helper scripts (push/pull remote settings); kept out of the
# repo rather than shared and edited per clone. Nothing in the repo reads them.
/push.sh
/pull.sh

# Core dumps and crash artifacts. `core` and `core.*` are ROOT-ANCHORED: bare
# `core` matches a directory at any depth, which was excluding
# COMPASS/src/core/ — the grader and the on-disk contract — from every push.
*.core
/core
/core.*
matrix1-*.core
*.stackdump
nohup.out
*.pid

# COMPASS: run artifacts. Every heavy output (collections, probes, steering
# sweeps) lives under $EMBED_ROOT (data/paths.py) and never enters the repo; these are the
# few things the scripts drop INSIDE the tree.
COMPASS/logs/
# COMPASS/info: the local scores ledger (info/scores.json, regenerated by
# src.utils.diagnostics.score_cells from the row files under $EMBED_ROOT) -- machine-local.
COMPASS/info/
COMPASS/**/resume_stamp.json
COMPASS/**/*_cache.csv
.suite/

# baselines: per-cell logs are written into the tree (outputs go to
# their own root). The *.log rule above already covers them; the
# slurm_*.out files are covered here.
baselines/logs/slurm_*.out
baselines/logs/slurm_*.err

# Serialized arrays and fitted models (belong in $EMBED_ROOT, not here)
*.npy
*.npz
*.joblib
*.pkl
*.pickle
*.h5
*.arrow

# Per-run tables the report stages regenerate from the per-config JSONs. Named
# rather than globbed on *.csv, because the repo has hand-written CSVs.
sweep_summary.csv
gate_sweep.csv
steering_reports.csv
suite_report.txt

# Editor and OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment files may contain tokens or machine-local paths.
.env
.env.*
!.env.example

# Local-only work, never published (2026-09-08): the published-baseline
# replications (baselines/, incl. the vendored reference repos) and the
# frontier API-model reference row. Both keep their machine paths hard-coded;
# COMPASS/data/paths.py carries only what the published pipeline reads.
/baselines/
/COMPASS/run_frontier.sh
/COMPASS/src/utils/frontier/
# The Slurm job cards are machine-specific (accounts, partitions, GPU counts)
# and local-only; the published entry points are run_compass.sh / ablations.sh.
/COMPASS/srun/

# Not part of the published code: the internal runbook and results ledger
# (cluster paths, job history), the reference-paper PDFs, and local editor /
# tool settings. All kept on disk; none tracked.
/COMPASS/RUNBOOK.md
/COMPASS/docs/
/.claude/

# Research notes, local-only.
/Rnd/
